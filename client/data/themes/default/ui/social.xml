<?xml version="1.0" encoding="utf-8"?>
<themes>
  <!-- TrainerCardWindow, MailWindow and the corresponding official theme resources. -->
  <theme name="trainercard" ref="resizableframe">
    <param name="fadeDurationShow"><int>200</int></param>
    <param name="fadeDurationHide"><int>200</int></param>
    <param name="background"><image>none</image></param>
    <param name="border"><border>30,0,0,0</border></param>
    <param name="titleAreaTop"><int>0</int></param>
    <param name="titleAreaBottom"><int>200</int></param>
    <param name="closeButtonX"><int>-35</int></param>
    <param name="closeButtonY"><int>28</int></param>
    <param name="fadeColorInactive"><color>#FFFFFFFF</color></param>
  </theme>
  <theme name="player-trainer-card" ref="-defaults">
    <param name="background"><image>trainer-card.background</image></param>
  </theme>
  <theme name="player-trainer-name" ref="label"><param name="font"><font>trainer-name</font></param></theme>
  <theme name="player-trainer-text" ref="label"><param name="font"><font>main</font></param></theme>
  <theme name="player-trainer-date" ref="player-trainer-text"><param name="textAlignment"><enum type="alignment">CENTER</enum></param></theme>
  <theme name="mail-window" ref="resizableframe">
    <param name="border"><border>30,10,10,10</border></param>
    <param name="fadeColorInactive"><color>#FFFFFFFF</color></param>
  </theme>
  <theme name="player-mail-tab" ref="togglebutton">
    <param name="background"><image>ui-tab-shop.background</image></param>
  </theme>
  <theme name="mail-inner" ref="scrollpane">
    <param name="border"><border>0</border></param>
    <theme name="vscrollbar" ref="vscrollbar-white"/>
  </theme>
  <theme name="player-mail-form" ref="dialoglayout">
    <param name="border"><border>10</border></param>
    <param name="defaultGap"><dimension>5,5</dimension></param>
    <theme name="editfield" ref="editfield"><param name="minHeight"><int>24</int></param></theme>
  </theme>
  <theme name="player-mail-label" ref="label"><param name="minWidth"><int>100</int></param></theme>
  <theme name="player-mail-body" ref="editfield">
    <param name="textAlignment"><enum type="alignment">TOPLEFT</enum></param>
    <param name="minHeight"><int>150</int></param>
    <theme name="renderer" ref="renderer"><param name="textAlignment"><enum type="alignment">TOPLEFT</enum></param></theme>
  </theme>
  <theme name="player-mail-header" ref="label"><param name="background"><image>ui-header.background</image></param></theme>
  <theme name="player-mail-row" ref="button"><param name="textAlignment"><enum type="alignment">LEFT</enum></param></theme>
</themes>
