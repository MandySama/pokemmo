<?xml version="1.0" encoding="UTF-8"?>
<themes>
    <theme name="console" ref="-dialog" allowWildcard="true">
        <param name="background">
            <image>console.background</image>
        </param>
        <theme name="scrollpane" ref="scrollpane">
            <param name="background">
                <image>none</image>
            </param>
            <param name="overlay">
                <image>none</image>
            </param>
        </theme>
        <theme name="editfield" ref="editfield" allowWildcard="true">
            <param name="background">
                <image>none</image>
            </param>
            <param name="border">
                <border>3</border>
            </param>
        </theme>
    </theme>
    <theme name="adminframe-nontab" ref="base-frame">
        <param name="border">
            <border>45,10,10,10</border>
        </param>
    </theme>
    <theme name="tp-menu" ref="base-frame">
        <param name="border">
            <border>45,18,6,6</border>
        </param>
    </theme>
    <theme name="world-tools-scroll" ref="scrollpane">
        <param name="border">
            <border>0</border>
        </param>
    </theme>
    <theme name="teleport-heading" ref="label">
        <param name="border">
            <border>5</border>
        </param>
    </theme>
    <theme name="teleport-destination" ref="button">
        <param name="minWidth">
            <int>130</int>
        </param>
    </theme>
    <theme name="teleport-tab" ref="togglebutton">
        <param name="border">
            <border>5,0,5,10</border>
        </param>
        <param name="">
            <image>ui-tab-vertical.*</image>
        </param>
        <param name="font">
            <font>pb-tab</font>
        </param>
        <param name="textAlignment">
            <enum type="alignment">LEFT</enum>
        </param>
    </theme>
    <theme name="database-header" ref="label">
        <param name="textAlignment">
            <enum type="alignment">CENTER</enum>
        </param>
        <param name="background">
            <image>ui-table-header.background</image>
        </param>
        <param name="border">
            <border>5,8</border>
        </param>
    </theme>
    <theme name="database-name-header" ref="database-header">
        <param name="border">
            <border>5,12,5,8</border>
        </param>
        <param name="textAlignment">
            <enum type="alignment">LEFT</enum>
        </param>
    </theme>
    <theme name="database-cell" ref="label">
        <param name="textAlignment">
            <enum type="alignment">CENTER</enum>
        </param>
        <param name="background">
            <image>ui-table-row.background</image>
        </param>
        <param name="border">
            <border>5,8</border>
        </param>
    </theme>
    <theme name="database-name-cell" ref="database-cell">
        <param name="textAlignment">
            <enum type="alignment">LEFT</enum>
        </param>
        <param name="border">
            <border>5,12,5,8</border>
        </param>
    </theme>
    <theme name="database-add" ref="button">
        <param name="border">
            <border>3,8</border>
        </param>
        <param name="textAlignment">
            <enum type="alignment">CENTER</enum>
        </param>
    </theme>
    <theme name="admin-value-panel" ref="confirm-panel" allowWildcard="true">
        <param name="minWidth">
            <int>294</int>
        </param>
        <param name="border">
            <border>18</border>
        </param>
        <param name="defaultGap">
            <dimension>8,8</dimension>
        </param>
        <theme name="label" ref="label">
            <param name="textAlignment">
                <enum type="alignment">LEFT</enum>
            </param>
        </theme>
    </theme>
</themes>
