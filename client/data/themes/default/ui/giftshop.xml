<?xml version="1.0" encoding="UTF-8"?>
<themes>
    <theme name="giftshop" ref="market-window"/>
    <theme name="giftshop-tab" ref="market-tab"/>
    <theme name="giftshop-scroll" ref="scrollpane">
        <param name="background"><image>ui-inner-frame-inverted.background</image></param>
    </theme>
    <theme name="giftshop-balance" ref="label">
        <param name="background"><image>ui-inputbox.background</image></param>
        <param name="border"><border>5</border></param>
    </theme>
    <theme name="giftshop-card" ref="widget">
        <param name="background"><image>ui-popup.background</image></param>
        <param name="border"><border>10,5,10,5</border></param>
    </theme>
    <theme name="giftshop-name" ref="label">
        <param name="textAlignment"><enum type="alignment">TOPLEFT</enum></param>
    </theme>
    <theme name="mobile-giftshop" ref="giftshop"/>
</themes>
