<?xml version="1.0" encoding="UTF-8"?>
<themes>
    <!-- GlobalTradeMarketWindow: official broker.xml dimensions, insets and shop tab assets. -->
    <theme name="market-window" ref="resizableframe">
        <param name="background"><image>ui-frame-red.background</image></param>
        <param name="titleAreaTop"><int>0</int></param>
        <param name="titleAreaLeft"><int>8</int></param>
        <param name="titleAreaBottom"><int>30</int></param>
        <param name="closeButtonY"><int>10</int></param>
        <param name="border"><border>30,10,5,10</border></param>
        <param name="fadeColorInactive"><color>#FFFFFFFF</color></param>
    </theme>
    <theme name="market-page" ref="widget">
        <param name="background"><image>ui-inner-frame-tab3.background</image></param>
        <param name="border"><border>10,10,10,5</border></param>
    </theme>
    <theme name="market-tab" ref="togglebutton">
        <param name="background"><image>ui-tab-shop.background</image></param>
        <param name="border"><border>0,10</border></param>
    </theme>
    <theme name="market-header" ref="label">
        <param name="background"><image>ui-header.background</image></param>
        <param name="textAlignment"><enum type="alignment">CENTER</enum></param>
        <param name="border"><border>6</border></param>
    </theme>
    <theme name="mobile-market-window" ref="market-window"/>
    <theme name="market-symbol" ref="button">
        <param name="font"><font>symbols-white</font></param>
    </theme>
</themes>
