<?xml version="1.0" encoding="utf-8"?>
<themes>
  <!-- 参考 ui/staff.xml 的 console：半透明黑背景、滚动输出及底部输入框。 -->
  <theme name="console" ref="-dialog" allowWildcard="true">
    <param name="background"><image>console.background</image></param>
    <theme name="scrollpane" ref="scrollpane">
      <param name="background"><image>none</image></param>
      <param name="overlay"><image>none</image></param>
    </theme>
    <theme name="editfield" ref="editfield" allowWildcard="true">
      <param name="background"><image>none</image></param>
      <param name="border"><border>3</border></param>
    </theme>
  </theme>

  <!-- TrainerHudWindow / ui/main.xml / ui/chat.xml. -->
  <theme name="world-status" ref="-defaults">
    <theme name="label" ref="label"><param name="font"><font>alphabeta-border</font></param></theme>
    <theme name="location" ref="-defaults"><param name="background"><image>world.location</image></param></theme>
    <theme name="money" ref="-defaults"><param name="background"><image>world.money</image></param></theme>
    <theme name="day" ref="-defaults"><param name="background"><image>world.day</image></param></theme>
    <theme name="night" ref="-defaults"><param name="background"><image>world.night</image></param></theme>
    <theme name="morning" ref="-defaults"><param name="background"><image>world.morning</image></param></theme>
  </theme>
  <theme name="world-bar" ref="-defaults">
    <theme name="shortcut" ref="button">
      <param name="background"><image>none</image></param>
      <param name="border"><border>0</border></param>
    </theme>
  </theme>
  <theme name="world-menu" ref="-defaults">
    <param name="background"><image>ui-popup.background</image></param>
    <param name="border"><border>4</border></param>
    <theme name="button" ref="button">
      <param name="background"><image>ui-popup-button.background</image></param>
      <param name="textAlignment"><enum type="alignment">CENTER</enum></param>
      <param name="border"><border>0</border></param>
    </theme>
  </theme>
  <theme name="world-chat-toggle" ref="-defaults">
    <param name="background"><image>world.chat</image></param>
  </theme>
  <theme name="world-chat" ref="-defaults">
    <param name="background"><image>console.background</image></param>
    <param name="border"><border>5</border></param>
    <theme name="editfield" ref="editfield" />
  </theme>
</themes>
