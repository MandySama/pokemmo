<?xml version='1.0' encoding='utf-8'?>
<themes>
  <theme name="world-status" ref="-defaults">
    <param name="defaultGap"><dimension>5,5</dimension></param>
    <param name="smallGap"><dimension>8,8</dimension></param>
    <param name="mediumGap"><dimension>10,10</dimension></param>
    <param name="largeGap"><dimension>15,15</dimension></param>
    <param name="namedGaps"><map /></param>
    <param name="border"><border>5</border></param>
    <theme name="label" ref="-defaults">
      <param name="font">
        <font>alphabeta-border</font>
      </param>
      <param name="border"><border>0</border></param>
    </theme>
    <theme name="location" ref="-defaults">
      <param name="background">
        <image>world.location</image>
      </param>
    </theme>
    <theme name="money" ref="-defaults">
      <param name="background">
        <image>world.money</image>
      </param>
    </theme>
    <theme name="day" ref="-defaults">
      <param name="background">
        <image>world.day</image>
      </param>
    </theme>
    <theme name="night" ref="-defaults">
      <param name="background">
        <image>world.night</image>
      </param>
    </theme>
    <theme name="morning" ref="-defaults">
      <param name="background">
        <image>world.morning</image>
      </param>
    </theme>
  </theme>
  <theme name="world-bar" ref="-defaults">
    <theme name="shortcut" ref="button">
      <param name="background">
        <image>none</image>
      </param>
      <param name="border">
        <border>0</border>
      </param>
    </theme>
  </theme>
  <theme name="world-menu" ref="-defaults">
    <param name="background">
      <image>ui-popup.background</image>
    </param>
    <param name="border">
      <border>4</border>
    </param>
    <theme name="button" ref="button">
      <param name="background">
        <image>ui-popup-button.background</image>
      </param>
      <param name="textAlignment">
        <enum type="alignment">CENTER</enum>
      </param>
      <param name="border">
        <border>0</border>
      </param>
    </theme>
  </theme>
</themes>
