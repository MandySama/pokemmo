      <frame duration="150" ref="ui-button.hover.background" tint="#00FFFFFF" />
      <frame duration="1" ref="ui-button.hover.background" tint="#99FFFFFF" />
    </animation>
    <composed name="ui-button.pressed">
      <alias ref="ui-button.pressed.background" />
      <alias ref="ui-button.hover-animation" />
    </composed>
    <composed name="ui-button.hover">
      <alias ref="ui-button.default" />
      <alias ref="ui-button.hover-animation" />
    </composed>
    <composed name="ui-button.selected">
      <alias ref="ui-button.default" />
      <alias ref="ui-button.selected.background" />
      <alias ref="ui-button.hover-animation" />
    </composed>
    <composed name="ui-button.selected.hover">
      <alias ref="ui-button.default" />
      <alias ref="ui-button.selected.background" />
      <alias ref="ui-button.hover-animation" />
    </composed>
    <composed name="ui-button.selected.alt">
      <alias ref="ui-button.default.selected" />
      <alias ref="ui-button.selected.background" />
    </composed>
    <composed name="ui-button.selected.hover.alt">
      <alias ref="ui-button.default.selected" />
      <alias ref="ui-button.selected.background" />
      <alias ref="ui-button.hover-animation" />
    </composed>
    <composed name="ui-button.disabled.selected">
      <alias ref="ui-button.disabled" />
      <alias ref="ui-button.selected.background" />
      <alias ref="ui-button.hover-animation" />
    </composed>
    <composed name="ui-button.disabled.hover">
      <alias ref="ui-button.disabled" />
      <alias ref="ui-button.hover-animation" />
    </composed>
    <select name="ui-button.background">
      <alias ref="ui-button.disabled.hover" if="disabled + hover" />
      <alias ref="ui-button.disabled.selected" if="disabled + (hover | keyboardFocus | selected)" />
      <alias ref="ui-button.disabled" if="disabled" />
      <alias ref="ui-button.pressed" if="pressed" />
      <alias ref="ui-button.selected.hover" if="hover + (keyboardFocus)" />
      <alias ref="ui-button.selected" if="keyboardFocus" />
      <alias ref="ui-button.hover" if="hover" />
      <alias ref="ui-button.default" />
    </select>
