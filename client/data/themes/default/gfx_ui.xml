    <area name="ui-checkbox.f11" xywh="364,190,12,15" inset="0,-5,0,0" center="true" />
    <area name="ui-checkbox.f12" xywh="364,190,13,15" inset="0,-4,0,0" center="true" />
    <area name="ui-checkbox.f13" xywh="364,190,14,15" inset="0,-3,0,0" center="true" />
    <area name="ui-checkbox.f14" xywh="364,190,15,15" inset="0,-2,0,0" center="true" />
    <animation name="ui-checkbox.animation" timeSource="selected" count="1">
      <frame duration="20" ref="ui-checkbox.f0" />
      <frame duration="20" ref="ui-checkbox.f1" />
      <frame duration="20" ref="ui-checkbox.f2" />
      <frame duration="20" ref="ui-checkbox.f3" />
      <frame duration="20" ref="ui-checkbox.f4" />
      <frame duration="20" ref="ui-checkbox.f5" />
      <frame duration="20" ref="ui-checkbox.f6" />
      <frame duration="20" ref="ui-checkbox.f7" />
      <frame duration="20" ref="ui-checkbox.f8" />
      <frame duration="20" ref="ui-checkbox.f9" />
      <frame duration="20" ref="ui-checkbox.f10" />
      <frame duration="20" ref="ui-checkbox.f11" />
      <frame duration="20" ref="ui-checkbox.f12" />
      <frame duration="20" ref="ui-checkbox.f13" />
      <frame duration="20" ref="ui-checkbox.f14" />
    </animation>
    <composed name="ui-checkbox.selected">
      <alias ref="ui-button.default" />
      <alias ref="ui-checkbox.animation" />
    </composed>
    <select name="ui-checkbox.background">
      <composed if="disabled + selected + hover">
        <alias ref="ui-button.disabled" />
        <alias ref="ui-checkbox.animation" />
        <alias ref="ui-button.hover-animation" />
      </composed>
      <composed if="hover + selected + keyboardFocus">
        <alias ref="ui-checkbox.selected" />
        <alias ref="ui-button.hover-animation" />
        <alias ref="ui-button.selected.background" />
      </composed>
      <composed if="hover + selected">
        <alias ref="ui-checkbox.selected" />
        <alias ref="ui-button.hover-animation" />
        <alias ref="ui-button.selected.background" />
      </composed>
      <composed if="disabled + selected">
        <alias ref="ui-button.disabled" />
        <alias ref="ui-checkbox.animation" />
      </composed>
      <alias ref="ui-button.disabled" if="disabled" />
      <composed if="selected + keyboardFocus">
        <alias ref="ui-checkbox.selected" />
        <alias ref="ui-button.selected.background" />
      </composed>
      <alias ref="ui-checkbox.selected" if="selected" />
      <composed if="hover">
        <alias ref="ui-button.default" />
        <alias ref="ui-button.hover-animation" />
      </composed>
      <alias ref="ui-button.selected" if="keyboardFocus" />
      <alias ref="ui-button.default" />
    </select>
