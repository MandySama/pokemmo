        <alias ref="ui-inputbox.hover-animation" />
        <alias ref="ui-inputbox-2px.selected.red" />
      </composed>
      <alias ref="ui-inputbox-2px.selected.red" />
    </select>
    <select name="ui-button.selected-green">
      <composed if="selected + hover">
        <alias ref="ui-inputbox.hover-animation" />
        <alias ref="ui-inputbox-2px.selected.green" />
      </composed>
      <composed if="selected">
        <alias ref="ui-inputbox-2px.selected.green" />
      </composed>
    </select>
    <select name="ui-inputbox-mixed.background">
      <composed if="selected | keyboardFocus">
        <alias ref="ui-inputbox.default" />
        <alias ref="ui-inputbox-2px.selected" />
      </composed>
