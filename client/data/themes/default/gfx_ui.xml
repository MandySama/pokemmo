    <area name="ui-button.pressed.background" xywh="290,116,29,29" splitx="L4,R4" splity="T4,B4" />
    <area name="ui-button.selected.background" tint="main-color" xywh="353,147,29,29" splitx="L4,R4" splity="T4,B4" />
    <area name="ui-button.disabled" xywh="322,147,29,29" splitx="L4,R4" splity="T4,B4" />
    <area name="ui-button.hover.background" xywh="353,116,29,29" splitx="L4,R4" tint="main-color" splity="T4,B4" />
