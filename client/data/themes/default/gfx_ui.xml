      <frame duration="150" ref="ui-inputbox-2px.default" tint="#000000" />
      <frame duration="1" ref="ui-inputbox-2px.default" tint="#000000" />
    </animation>
    <select name="ui-button.background-defaultdex">
      <composed if="selected | keyboardFocus | hover">
        <alias ref="ui-inputbox.hover-animation" />
        <alias ref="ui-inputbox-2px.background" />
      </composed>
      <alias ref="ui-inputbox-2px.background" />
    </select>
    <select name="ui-button.background-blue">
