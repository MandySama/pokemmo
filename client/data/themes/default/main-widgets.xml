<?xml version='1.0' encoding='utf-8'?>
<themes>
  <theme name="character-summary-label" ref="label">
    <param name="font">
      <font>pb-dark</font>
    </param>
  </theme>
  <theme name="logingui" ref="-defaults">
    <theme name="login-panel" ref="base-frame" allowWildcard="true">
      <param name="background">
        <image>label1.background</image>
      </param>
      <param name="border">
        <border>20</border>
      </param>
      <param name="defaultGap">
        <dimension>5,5</dimension>
      </param>
      <param name="smallGap">
        <dimension>8,8</dimension>
      </param>
      <param name="mediumGap">
        <dimension>10,10</dimension>
      </param>
      <param name="largeGap">
        <dimension>15,15</dimension>
      </param>
      <param name="namedGaps">
        <map />
      </param>
      <theme name="label" ref="label">
        <param name="font">
          <font>alphabeta-border</font>
        </param>
        <param name="textAlignment">
          <enum type="alignment">CENTER</enum>
        </param>
      </theme>
    </theme>
    <theme name="logo" ref="-defaults">
      <param name="background">
        <image>background-image</image>
      </param>
    </theme>
    <theme name="login-window" ref="base-frame" allowWildcard="true">
      <param name="minWidth">
        <int>300</int>
      </param>
      <param name="minHeight">
        <int>150</int>
      </param>
      <theme name="dialoglayout" ref="dialoglayout">
        <param name="defaultGap">
          <dimension>8,8</dimension>
        </param>
        <param name="border">
          <border>60,20,20,20</border>
        </param>
      </theme>
    </theme>
    <theme name="serverselect-window" ref="login-window" allowWildcard="true">
      <param name="minWidth">
        <int>340</int>
      </param>
      <param name="minHeight">
        <int>300</int>
      </param>
    </theme>
    <theme name="label" ref="label">
      <param name="font">
        <font>alphabeta-border</font>
      </param>
    </theme>
  </theme>
  <theme name="characterselectgui" ref="logingui">
    <param name="textAlignment">
      <enum type="alignment">RIGHT</enum>
    </param>
    <theme name="login-panel" ref="base-frame" allowWildcard="true">
      <param name="titleAreaRight">
        <int>-10</int>
      </param>
      <param name="defaultGap">
        <dimension>5,5</dimension>
      </param>
      <param name="smallGap">
        <dimension>8,8</dimension>
      </param>
      <param name="mediumGap">
        <dimension>10,10</dimension>
      </param>
      <param name="largeGap">
        <dimension>15,15</dimension>
      </param>
      <param name="namedGaps">
        <map />
      </param>
      <param name="border">
        <border>40,7,7,7</border>
      </param>
      <theme name="container" ref="-dialog" allowWildcard="true">
        <param name="border">
          <border>7,7</border>
        </param>
        <param name="background">
          <image>none</image>
        </param>
        <theme name="character-select-button" ref="-defaults" allowWildcard="true">
          <param name="background">
            <image>ui-inputbox-mixed.background</image>
          </param>
          <param name="font">
            <font>alphabeta</font>
          </param>
          <param name="border">
            <border>7,7</border>
          </param>
          <param name="minWidth">
            <int>200</int>
          </param>
          <param name="minHeight">
            <int>120</int>
          </param>
          <param name="textAlignment">
            <enum type="alignment">BOTTOM</enum>
          </param>
          <theme name="dialoglayout" ref="-dialog" allowWildcard="true">
            <theme name="label" ref="label" allowWildcard="true">
              <param name="font">
                <font>pb-dark</font>
              </param>
            </theme>
            <theme name="spritelabel" ref="-defaults" allowWildcard="true">
              <param name="font">
                <font>alphabeta</font>
              </param>
            </theme>
          </theme>
        </theme>
        <theme name="button" ref="button" allowWildcard="true">
          <param name="border">
            <border>7,7</border>
          </param>
        </theme>
      </theme>
      <theme name="label" ref="label" allowWildcard="true">
        <param name="textAlignment">
          <enum type="alignment">CENTER</enum>
        </param>
      </theme>
    </theme>
  </theme>
  <theme name="changelog-frame" ref="resizableframe">
    <param name="background">
      <image>none</image>
    </param>
    <theme name="dialoglayout" ref="-defaults">
      <param name="defaultGap">
        <dimension>5,5</dimension>
      </param>
      <param name="smallGap">
        <dimension>8,8</dimension>
      </param>
      <param name="mediumGap">
        <dimension>10,10</dimension>
      </param>
      <param name="largeGap">
        <dimension>15,15</dimension>
      </param>
      <param name="namedGaps">
        <map />
      </param>
      <param name="border">
        <border>0,5,5,5</border>
      </param>
      <theme name="button" ref="label">
        <param name="background">
          <image>label2.background</image>
        </param>
        <param name="border">
          <border>5</border>
        </param>
        <param name="font">
          <font>alphabeta</font>
        </param>
      </theme>
    </theme>
  </theme>
  <theme name="tooltipwindow" ref="-defaults">
    <param name="background">
      <image>tooltip-left.background</image>
    </param>
    <param name="border">
      <border>8,8,12,8</border>
    </param>
    <param name="fadeInTime">
      <int>250</int>
    </param>
    <param name="overlay">
      <image>none</image>
    </param>
    <theme name="label" ref="-defaults">
      <param name="font">
        <font>tooltip-font</font>
      </param>
    </theme>
    <theme name="title" ref="-defaults">
      <param name="font">
        <font>title-font-black</font>
      </param>
    </theme>
    <theme name="dialoglayout" ref="-defaults">
      <param name="border">
        <border>0</border>
      </param>
      <param name="defaultGap">
        <dimension>5,5</dimension>
      </param>
      <param name="smallGap">
        <dimension>8,8</dimension>
      </param>
      <param name="mediumGap">
        <dimension>10,10</dimension>
      </param>
      <param name="largeGap">
        <dimension>15,15</dimension>
      </param>
      <param name="namedGaps">
        <map />
      </param>
      <theme name="label" ref="-defaults">
        <param name="font">
          <font>tooltip-font</font>
        </param>
      </theme>
    </theme>
  </theme>
  <theme name="world-status" ref="-defaults">
    <param name="defaultGap">
      <dimension>5,5</dimension>
    </param>
    <param name="smallGap">
      <dimension>8,8</dimension>
    </param>
    <param name="mediumGap">
      <dimension>10,10</dimension>
    </param>
    <param name="largeGap">
      <dimension>15,15</dimension>
    </param>
    <param name="namedGaps">
      <map />
    </param>
    <param name="border">
      <border>5</border>
    </param>
    <theme name="label" ref="-defaults">
      <param name="font">
        <font>alphabeta-border</font>
      </param>
      <param name="border">
        <border>0</border>
      </param>
    </theme>
    <theme name="location" ref="-defaults">
      <param name="background">
        <image>world.location</image>
      </param>
    </theme>
    <theme name="money" ref="-defaults">
      <param name="background">
        <image>world.money</image>
      </param>
    </theme>
    <theme name="day" ref="-defaults">
      <param name="background">
        <image>world.day</image>
      </param>
    </theme>
    <theme name="night" ref="-defaults">
      <param name="background">
        <image>world.night</image>
      </param>
    </theme>
    <theme name="morning" ref="-defaults">
      <param name="background">
        <image>world.morning</image>
      </param>
    </theme>
  </theme>
</themes>