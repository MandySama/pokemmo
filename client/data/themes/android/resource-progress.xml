<?xml version='1.0' encoding='utf-8'?>
<themes>
  <fontDef name="med-noshadow-18-white" filename="../default/res/fonts/NotoSansCJK-Bold.ttc" faces="sc,tc,jp" font_color="#FFFFFF" size="18" />
  <fontDef name="med-noshadow-22-white" filename="../default/res/fonts/NotoSansCJK-Bold.ttc" faces="sc,tc,jp" font_color="#FFFFFF" size="22" />
  <fontDef name="22pt-gray" ref="med-noshadow-22-white" color="#333333" />
  <images file="../default/res/pokemmo_ui.png" filter="nearest">
    <area name="ui-popup.background" xywh="317,247,42,42" splitx="L5,R5" splity="T5,B5" />
  </images>
  <images file="../default/res/main-hud.png" filter="nearest">
    <area name="label1.background" tint="#95949494" xywh="9,191,5,5" inset="0,0,0,0" />
  </images>
  <images file="res/ui-mobile-atlas.png" filter="nearest">
    <grid name="mobile.progress.overlay" weightsX="0,1,0" weightsY="0,1,0">
      <area xywh="431,522,15,12" />
      <area xywh="446,522,1,12" />
      <area xywh="451,522,15,12" />
      <area xywh="431,534,15,4" />
      <area xywh="446,534,1,4" />
      <area xywh="451,534,15,4" />
      <area xywh="431,538,15,12" />
      <area xywh="446,538,1,12" />
      <area xywh="451,538,15,12" />
    </grid>
    <grid name="mobile.progress.background" weightsX="0,1,0" weightsY="0,1,0">
      <area xywh="431,553,15,12" />
      <area xywh="446,553,1,12" />
      <area xywh="451,553,15,12" />
      <area xywh="431,565,15,4" />
      <area xywh="446,565,1,4" />
      <area xywh="451,565,15,4" />
      <area xywh="431,569,15,12" />
      <area xywh="446,569,1,12" />
      <area xywh="451,569,15,12" />
    </grid>
    <grid name="-mobile.progress.progressImage" weightsX="1" inset="8,0" weightsY="1">
      <area xywh="475,522,1,28" splity="T12,B12" />
    </grid>
    <alias name="mobile.progress.green.progressImage" ref="-mobile.progress.progressImage" tint="#2ECC71" />
  </images>
  <theme name="-defaults">
    <param name="background">
      <image>none</image>
    </param>
    <param name="overlay">
      <image>none</image>
    </param>
    <param name="font">
      <font>med-noshadow-18-white</font>
    </param>
    <param name="textAlignment">
      <enum type="alignment">left</enum>
    </param>
    <param name="font2">
      <font>med-noshadow-18-white</font>
    </param>
    <param name="textAlignment2">
      <enum type="alignment">left</enum>
    </param>
    <param name="minWidth">
      <int>0</int>
    </param>
    <param name="minHeight">
      <int>0</int>
    </param>
    <param name="maxWidth">
      <int>0</int>
    </param>
    <param name="maxHeight">
      <int>0</int>
    </param>
    <theme name="" ref="*" />
  </theme>
  <theme name="label" ref="-defaults" allowWildcard="true" />
  <theme name="confirm-widget" ref="-defaults">
    <param name="background">
      <image>label1.background</image>
    </param>
    <param name="titleAreaTop">
      <int>0</int>
    </param>
    <param name="titleAreaLeft">
      <int>0</int>
    </param>
    <param name="titleAreaRight">
      <int>0</int>
    </param>
    <param name="titleAreaBottom">
      <int>0</int>
    </param>
    <param name="hasCloseButton">
      <bool>false</bool>
    </param>
    <param name="closeButtonX">
      <int>0</int>
    </param>
    <param name="closeButtonY">
      <int>0</int>
    </param>
    <param name="hasResizeHandle">
      <bool>false</bool>
    </param>
    <param name="resizeHandleX">
      <int>0</int>
    </param>
    <param name="resizeHandleY">
      <int>0</int>
    </param>
    <param name="fadeColorInactive">
      <color>white</color>
    </param>
    <param name="fadeDurationActivate">
      <int>0</int>
    </param>
    <param name="fadeDurationDeactivate">
      <int>0</int>
    </param>
    <param name="fadeDurationShow">
      <int>0</int>
    </param>
    <param name="fadeDurationHide">
      <int>0</int>
    </param>
  </theme>
  <theme name="confirm-panel" ref="-defaults" allowWildcard="true">
    <param name="background">
      <image>ui-popup.background</image>
    </param>
    <param name="border">
      <border>20</border>
    </param>
    <param name="defaultGap">
      <dimension>5,5</dimension>
    </param>
    <param name="smallGap">
      <dimension>8,8</dimension>
    </param>
    <param name="mediumGap">
      <dimension>10,10</dimension>
    </param>
    <param name="largeGap">
      <dimension>15,15</dimension>
    </param>
    <param name="namedGaps">
      <map />
    </param>
    <theme name="label" ref="label" allowWildcard="true">
      <param name="font">
        <font>med-noshadow-18-white</font>
      </param>
      <param name="textAlignment">
        <enum type="alignment">CENTER</enum>
      </param>
    </theme>
    <theme name="progressbar" ref="-defaults" allowWildcard="true">
      <param name="progressImage">
        <image>mobile.progress.green.progressImage</image>
      </param>
      <param name="background">
        <image>mobile.progress.background</image>
      </param>
      <param name="overlay">
        <image>mobile.progress.overlay</image>
      </param>
      <param name="border">
        <border>0,0</border>
      </param>
      <param name="minWidth">
        <int>350</int>
      </param>
      <param name="minHeight">
        <int>80</int>
      </param>
      <param name="textAlignment">
        <enum type="alignment">CENTER</enum>
      </param>
      <param name="font">
        <font>22pt-gray</font>
      </param>
    </theme>
  </theme>
</themes>