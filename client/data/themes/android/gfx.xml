  </images>
  <images file="res/ui-bottom-background.png" filter="linear">
    <grid name="mobile.window.bottom.background" weightsX="1" weightsY="0,1,0">
      <area xywh="0,0,1024,60" />
      <area xywh="0,60,1024,600" />
      <area xywh="0,660,1024,60" />
    </grid>
  </images>
  <images file="res/android_ui.png" filter="nearest">
    <animation name="mobile.tab.animation" timeSource="selected" count="1">
      <frame duration="250" ref="mobile.tab.background" tint="#00FFFFFF" />
      <frame duration="1" ref="mobile.tab.background" tint="#FFFFFFFF" />
    </animation>
    <area name="mobile.tab.backgrounddd" xywh="213,60,5,5" splitx="L1,R1" />
    <animation name="mobile.tab.hover" timeSource="hover" count="1">
      <frame duration="100" ref="mobile.tab.background" tint="#00FFFFFF" />
      <frame duration="1" ref="mobile.tab.background" tint="#A0FFFFFF" />
    </animation>
  </images>
