<?xml version="1.0" encoding="utf-8"?>
<themes>
  <!-- android-monster-dex: full-screen panel, larger cards and touch targets. -->
  <theme name="monsterdex-frame" ref="mobile-panel" overwrite="true" />
  <theme name="monsterdex-button" ref="monsterdex-button" overwrite="true">
    <param name="font"><font>med-noshadow-18-white</font></param>
  </theme>
  <theme name="pokedex-value" ref="pokedex-value" overwrite="true">
    <param name="font"><font>med-noshadow-18-white</font></param>
    <param name="border"><border>8</border></param>
  </theme>
  <theme name="pokedex-title" ref="pokedex-title" overwrite="true">
    <param name="font"><font>med-noshadow-18-white</font></param>
    <param name="border"><border>8</border></param>
  </theme>
  <theme name="pokedex-description" ref="pokedex-description" overwrite="true">
    <param name="font"><font>med-noshadow-18-white</font></param>
  </theme>
  <theme name="pokedex-counter" ref="pokedex-counter" overwrite="true">
    <param name="font"><font>med-noshadow-18-white</font></param>
  </theme>
  <theme name="pokedex-tab" ref="button" overwrite="true">
    <param name="font"><font>med-noshadow-22-white</font></param>
  </theme>
  <theme name="pokedex-evolution-name" ref="pokedex-evolution-name" overwrite="true">
    <param name="font"><font>med-noshadow-18-white</font></param>
  </theme>
</themes>
