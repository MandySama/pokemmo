<?xml version='1.0' encoding='utf-8'?>
<themes>
  <theme name="customize-widget" ref="mobile-panel" overwrite="true">
    <theme name="dialoglayout" ref="dialoglayout">
      <theme name="dialoglayout" ref="dialoglayout">
        <theme name="combobox" ref="combobox" allowWildcard="true">
          <param name="minWidth">
            <int>300</int>
          </param>
        </theme>
      </theme>
      <param name="border">
        <border>70,10,80,10</border>
      </param>
      <param name="defaultGap">
        <dimension>5,5</dimension>
      </param>
      <param name="smallGap">
        <dimension>8,8</dimension>
      </param>
      <param name="mediumGap">
        <dimension>10,10</dimension>
      </param>
      <param name="namedGaps">
        <map />
      </param>
    </theme>
  </theme>
  <theme name="customization-label" ref="label" allowWildcard="true">
    <param name="font">
      <font>med-noshadow-18-white</font>
    </param>
    <param name="textAlignment">
      <enum type="alignment">center</enum>
    </param>
    <param name="background">
      <image>ui-header.background</image>
    </param>
    <param name="border">
      <border>3,3</border>
    </param>
    <param name="minWidth">
      <int>300</int>
    </param>
    <param name="minHeight">
      <int>40</int>
    </param>
  </theme>
  <theme name="customization-color" ref="button" allowWildcard="true">
    <param name="minWidth">
      <int>36</int>
    </param>
    <param name="minHeight">
      <int>36</int>
    </param>
    <param name="border">
      <border>3,3</border>
    </param>
    <param name="font">
      <font>pb-dark</font>
    </param>
    <param name="textAlignment">
      <enum type="alignment">center</enum>
    </param>
    <param name="background">
      <image>none</image>
    </param>
    <param name="colorIcon">
      <image>customization.colorswatch</image>
    </param>
  </theme>
  <theme name="color-button" ref="button" allowWildcard="true">
    <param name="font">
      <font>pb-dark</font>
    </param>
    <param name="textAlignment">
      <enum type="alignment">center</enum>
    </param>
    <param name="background">
      <image>color-picker.background</image>
    </param>
    <param name="minWidth">
      <int>65</int>
    </param>
    <param name="minHeight">
      <int>65</int>
    </param>
  </theme>
  <theme name="color-dialog" ref="-defaults" allowWildcard="true">
    <param name="font">
      <font>pb-dark</font>
    </param>
    <param name="background">
      <image>none</image>
    </param>
    <param name="border">
      <border>70,10,80,10</border>
    </param>
    <param name="defaultGap">
      <dimension>5,5</dimension>
    </param>
    <param name="smallGap">
      <dimension>8,8</dimension>
    </param>
    <param name="mediumGap">
      <dimension>10,10</dimension>
    </param>
    <param name="largeGap">
      <dimension>15,15</dimension>
    </param>
    <param name="namedGaps">
      <map />
    </param>
  </theme>
  <theme name="customization-preview-previous" ref="-defaults">
    <param name="background">
      <image>customization.preview-previous</image>
    </param>
    <param name="minWidth">
      <int>128</int>
    </param>
    <param name="minHeight">
      <int>128</int>
    </param>
  </theme>
  <theme name="customization-preview-next" ref="-defaults">
    <param name="background">
      <image>customization.preview-next</image>
    </param>
    <param name="minWidth">
      <int>128</int>
    </param>
    <param name="minHeight">
      <int>128</int>
    </param>
  </theme>
</themes>