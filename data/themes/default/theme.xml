<?xml version="1.0" encoding="UTF-8"?>
<themes>
    <!-- 登录主题沿用参考图集和字体，局部控件尺寸保持参考登录布局。 -->
    <constantDef name="main-color">
        <color>#5db1ff</color>
    </constantDef>
    <constantDef name="sub-color">
        <color>#5db1ff</color>
    </constantDef>
    <images file="res/bg.png" filter="nearest">
        <area name="background-image" xywh="*"/>
    </images>
    <images file="res/user-interface.png" filter="nearest">
        <area name="-field-cursor" xywh="0,496,1,1" tint="sub-color"/>
        <animation name="field-cursor" timeSource="keyboardFocus">
            <frame ref="-field-cursor" duration="500"/>
            <frame ref="none" duration="500"/>
        </animation>
        <area name="field-selection" xywh="0,496,1,1" tint="sub-color"/>
    </images>
    <fontDef name="default" filename="res/fonts/NotoSansCJK-Medium.ttc" color="#FFFFFF"/>
    <fontDef name="alphabeta" filename="res/fonts/NotoSansCJK-Medium.ttc" color="#FFFFFF"/>
    <fontDef name="pb-dark" filename="res/fonts/NotoSansCJK-Medium.ttc" color="#FFFFFF">
        <fontParam if="disabled" color="#A9A9A9"/>
        <fontParam if="pressed" offsetX="1" offsetY="1"/>
    </fontDef>
    <fontDef name="alphabeta-border" filename="res/fonts/NotoSansCJK-Medium.ttc" color="#FFFFFF" border_width="1" border_color="#434343"/>
    <fontDef name="title-font" filename="res/fonts/NotoSansCJK-Bold.ttc" color="#FFFFFF" size_cjk="15"/>
    <fontDef name="listbox-display" filename="res/fonts/NotoSansCJK-Medium.ttc" color="#FFFFFF">
        <fontParam if="disabled" color="#888888"/>
    </fontDef>
    <images file="res/pokemmo_ui.png" filter="nearest">
        <area name="ui-spacer.default" xywh="330,8,8,3"/>
        <area name="ui-popup-button.selected" xywh="364,254,35,29" splitx="L4,R4" splity="T4,B4"/>
        <area name="ui-popup-button.default" xywh="0,0,44,14" tint="#00FFFFFF"/>
        <animation name="ui-popup-button.hover" timeSource="hover" count="1">
            <frame duration="150" ref="ui-popup-button.selected" tint="#00FFFFFF"/>
            <frame duration="1" ref="ui-popup-button.selected" tint="#FFFFFFFF"/>
        </animation>
        <select name="ui-popup-button.background">
            <alias ref="ui-popup-button.selected" if="keyboardFocus | selected"/>
            <alias ref="ui-popup-button.hover" if="hover"/>
            <alias ref="ui-popup-button.default"/>
        </select>
        <area name="ui-popup.background" xywh="317,247,42,42" splitx="L5,R5" splity="T5,B5"/>
        <grid name="ui-inner-frame-tab.background" weightsX="0,1,0" weightsY="0,0,1,0" inset="-2,0,0,0">
            <area xywh="5,151,10,11"/>
            <area xywh="33,151,10,11" tiled="true"/>
            <area xywh="67,151,10,11"/>
            <area xywh="5,162,10,28"/>
            <area xywh="33,162,10,28" tiled="true"/>
            <area xywh="67,162,10,28"/>
            <area xywh="5,124,10,4"/>
            <area xywh="33,124,10,4"/>
            <area xywh="67,124,10,4"/>
            <area xywh="5,131,10,5"/>
            <area xywh="33,131,10,5"/>
            <area xywh="67,131,10,5"/>
        </grid>
        <area name="ui-button.default" xywh="322,116,29,29" splitx="L4,R4" splity="T4,B4"/>
        <area name="ui-button.pressed.background" xywh="290,116,29,29" splitx="L4,R4" splity="T4,B4"/>
        <area name="ui-button.selected.background" tint="main-color" xywh="353,147,29,29" splitx="L4,R4" splity="T4,B4"/>
        <area name="ui-button.disabled" xywh="322,147,29,29" splitx="L4,R4" splity="T4,B4"/>
        <area name="ui-button.hover.background" xywh="353,116,29,29" splitx="L4,R4" tint="main-color" splity="T4,B4"/>
        <animation name="ui-button.hover-animation" timeSource="hover" count="1">
            <frame duration="150" ref="ui-button.hover.background" tint="#00FFFFFF"/>
            <frame duration="1" ref="ui-button.hover.background" tint="#99FFFFFF"/>
        </animation>
        <composed name="ui-button.pressed">
            <alias ref="ui-button.pressed.background"/>
            <alias ref="ui-button.hover-animation"/>
        </composed>
        <composed name="ui-button.hover">
            <alias ref="ui-button.default"/>
            <alias ref="ui-button.hover-animation"/>
        </composed>
        <composed name="ui-button.selected">
            <alias ref="ui-button.default"/>
            <alias ref="ui-button.selected.background"/>
            <alias ref="ui-button.hover-animation"/>
        </composed>
        <composed name="ui-button.selected.hover">
            <alias ref="ui-button.default"/>
            <alias ref="ui-button.selected.background"/>
            <alias ref="ui-button.hover-animation"/>
        </composed>
        <composed name="ui-button.disabled.selected">
            <alias ref="ui-button.disabled"/>
            <alias ref="ui-button.selected.background"/>
            <alias ref="ui-button.hover-animation"/>
        </composed>
        <composed name="ui-button.disabled.hover">
            <alias ref="ui-button.disabled"/>
            <alias ref="ui-button.hover-animation"/>
        </composed>
        <select name="ui-button.background">
            <alias ref="ui-button.disabled.hover" if="disabled + hover"/>
            <alias ref="ui-button.disabled.selected" if="disabled + (hover | keyboardFocus | selected)"/>
            <alias ref="ui-button.disabled" if="disabled"/>
            <alias ref="ui-button.pressed" if="pressed"/>
            <alias ref="ui-button.selected.hover" if="hover + (keyboardFocus)"/>
            <alias ref="ui-button.selected" if="keyboardFocus"/>
            <alias ref="ui-button.hover" if="hover"/>
            <alias ref="ui-button.default"/>
        </select>
        <area name="ui-checkbox.f0" xywh="364,190,1,15" inset="0,-14,0,0" center="true"/>
        <area name="ui-checkbox.f1" xywh="364,190,2,15" inset="0,-15,0,0" center="true"/>
        <area name="ui-checkbox.f2" xywh="364,190,3,15" inset="0,-14,0,0" center="true"/>
        <area name="ui-checkbox.f3" xywh="364,190,4,15" inset="0,-13,0,0" center="true"/>
        <area name="ui-checkbox.f4" xywh="364,190,5,15" inset="0,-12,0,0" center="true"/>
        <area name="ui-checkbox.f5" xywh="364,190,6,15" inset="0,-11,0,0" center="true"/>
        <area name="ui-checkbox.f6" xywh="364,190,7,15" inset="0,-10,0,0" center="true"/>
        <area name="ui-checkbox.f7" xywh="364,190,8,15" inset="0,-9,0,0" center="true"/>
        <area name="ui-checkbox.f8" xywh="364,190,9,15" inset="0,-8,0,0" center="true"/>
        <area name="ui-checkbox.f9" xywh="364,190,10,15" inset="0,-7,0,0" center="true"/>
        <area name="ui-checkbox.f10" xywh="364,190,11,15" inset="0,-6,0,0" center="true"/>
        <area name="ui-checkbox.f11" xywh="364,190,12,15" inset="0,-5,0,0" center="true"/>
        <area name="ui-checkbox.f12" xywh="364,190,13,15" inset="0,-4,0,0" center="true"/>
        <area name="ui-checkbox.f13" xywh="364,190,14,15" inset="0,-3,0,0" center="true"/>
        <area name="ui-checkbox.f14" xywh="364,190,15,15" inset="0,-2,0,0" center="true"/>
        <animation name="ui-checkbox.animation" timeSource="selected" count="1">
            <frame duration="20" ref="ui-checkbox.f0"/>
            <frame duration="20" ref="ui-checkbox.f1"/>
            <frame duration="20" ref="ui-checkbox.f2"/>
            <frame duration="20" ref="ui-checkbox.f3"/>
            <frame duration="20" ref="ui-checkbox.f4"/>
            <frame duration="20" ref="ui-checkbox.f5"/>
            <frame duration="20" ref="ui-checkbox.f6"/>
            <frame duration="20" ref="ui-checkbox.f7"/>
            <frame duration="20" ref="ui-checkbox.f8"/>
            <frame duration="20" ref="ui-checkbox.f9"/>
            <frame duration="20" ref="ui-checkbox.f10"/>
            <frame duration="20" ref="ui-checkbox.f11"/>
            <frame duration="20" ref="ui-checkbox.f12"/>
            <frame duration="20" ref="ui-checkbox.f13"/>
            <frame duration="20" ref="ui-checkbox.f14"/>
        </animation>
        <composed name="ui-checkbox.selected">
            <alias ref="ui-button.default"/>
            <alias ref="ui-checkbox.animation"/>
        </composed>
        <select name="ui-checkbox.background">
            <composed if="disabled + selected + hover">
                <alias ref="ui-button.disabled"/>
                <alias ref="ui-checkbox.animation"/>
                <alias ref="ui-button.hover-animation"/>
            </composed>
            <composed if="hover + selected + keyboardFocus">
                <alias ref="ui-checkbox.selected"/>
                <alias ref="ui-button.hover-animation"/>
                <alias ref="ui-button.selected.background"/>
            </composed>
            <composed if="hover + selected">
                <alias ref="ui-checkbox.selected"/>
                <alias ref="ui-button.hover-animation"/>
                <alias ref="ui-button.selected.background"/>
            </composed>
            <composed if="disabled + selected">
                <alias ref="ui-button.disabled"/>
                <alias ref="ui-checkbox.animation"/>
            </composed>
            <alias ref="ui-button.disabled" if="disabled"/>
            <composed if="selected + keyboardFocus">
                <alias ref="ui-checkbox.selected"/>
                <alias ref="ui-button.selected.background"/>
            </composed>
            <alias ref="ui-checkbox.selected" if="selected"/>
            <composed if="hover">
                <alias ref="ui-button.default"/>
                <alias ref="ui-button.hover-animation"/>
            </composed>
            <alias ref="ui-button.selected" if="keyboardFocus"/>
            <alias ref="ui-button.default"/>
        </select>
        <area name="ui-inputbox.default" xywh="326,8,16,16" splitx="L3,R3" splity="T3,B3"/>
        <area name="ui-inputbox.selected" xywh="326,26,16,16" splitx="L3,R3" splity="T3,B3" tint="sub-color"/>
        <select name="ui-inputbox.background">
            <composed if="selected | keyboardFocus">
                <alias ref="ui-inputbox.default"/>
                <alias ref="ui-inputbox.selected"/>
            </composed>
            <alias ref="ui-inputbox.default"/>
        </select>
    </images>
    <inputMapDef name="-defaultInputMap">
        <action name="selectAll">ctrl A</action>
        <action name="cut">ctrl X</action>
        <action name="copy">ctrl C</action>
        <action name="paste">ctrl V</action>
    </inputMapDef>
    <theme name="-defaults">
        <param name="inputMap">
            <inputMap>-defaultInputMap</inputMap>
        </param>
        <param name="font">
            <font>default</font>
        </param>
        <param name="background">
            <image>none</image>
        </param>
        <param name="overlay">
            <image>none</image>
        </param>
        <param name="minWidth">
            <int>0</int>
        </param>
        <param name="minHeight">
            <int>0</int>
        </param>
        <param name="maxWidth">
            <int>0</int>
        </param>
        <param name="maxHeight">
            <int>0</int>
        </param>
        <param name="textAlignment">
            <enum type="alignment">LEFT</enum>
        </param>
    </theme>
    <theme name="label" ref="-defaults" allowWildcard="true"/>
    <theme name="button" ref="-defaults" allowWildcard="true">
        <param name="font">
            <font>pb-dark</font>
        </param>
        <param name="border">
            <border>7,0</border>
        </param>
        <param name="">
            <image>ui-button.*</image>
        </param>
        <param name="textAlignment">
            <enum type="alignment">CENTER</enum>
        </param>
    </theme>
    <theme name="togglebutton" ref="-defaults" allowWildcard="true">
        <param name="font">
            <font>pb-dark</font>
        </param>
        <param name="border">
            <border>0,0</border>
        </param>
        <param name="background">
            <image>ui-checkbox.background</image>
        </param>
        <param name="textAlignment">
            <enum type="alignment">CENTER</enum>
        </param>
    </theme>
    <theme name="editfield" ref="-defaults" allowWildcard="true">
        <param name="background">
            <image>ui-inputbox.background</image>
        </param>
        <param name="font">
            <font>pb-dark</font>
        </param>
        <param name="border">
            <border>4,5,5,5</border>
        </param>
        <param name="passwordChar">
            <int>35</int>
        </param>
        <param name="maxWidth">
            <int>32767</int>
        </param>
        <param name="columns">
            <int>20</int>
        </param>
        <param name="cursor">
            <image>field-cursor</image>
        </param>
        <param name="selection">
            <image>field-selection</image>
        </param>
        <theme name="renderer" ref="-defaults">
            <param name="font">
                <font>pb-dark</font>
            </param>
            <param name="border">
                <border>0</border>
            </param>
            <param name="textAlignment">
                <enum type="alignment">LEFT</enum>
            </param>
        </theme>
        <param name="autocompletion-height">
            <int>150</int>
        </param>
    </theme>
    <theme name="dialoglayout" ref="-defaults" allowWildcard="true">
        <param name="defaultGap">
            <dimension>5,5</dimension>
        </param>
        <param name="smallGap">
            <dimension>8,8</dimension>
        </param>
        <param name="mediumGap">
            <dimension>10,10</dimension>
        </param>
        <param name="largeGap">
            <dimension>15,15</dimension>
        </param>
        <param name="namedGaps">
            <map>
                <param name="radiobutton">
                    <gap>0</gap>
                </param>
                <param name="adjuster">
                    <gap>0</gap>
                </param>
                <param name="vbutton">
                    <gap>0</gap>
                </param>
            </map>
        </param>
    </theme>
    <theme name="resizableframe" ref="-defaults" allowWildcard="true">
        <param name="border">
            <border>30,0,0,0</border>
        </param>
        <param name="titleAreaTop">
            <int>1</int>
        </param>
        <param name="titleAreaLeft">
            <int>11</int>
        </param>
        <param name="titleAreaRight">
            <int>-1</int>
        </param>
        <param name="titleAreaBottom">
            <int>25</int>
        </param>
        <param name="closeButtonX">
            <int>-24</int>
        </param>
        <param name="closeButtonY">
            <int>6</int>
        </param>
        <param name="hasResizeHandle">
            <bool>false</bool>
        </param>
        <param name="resizeHandleX">
            <int>0</int>
        </param>
        <param name="resizeHandleY">
            <int>0</int>
        </param>
        <param name="fadeColorInactive">
            <color>white</color>
        </param>
        <param name="fadeDurationActivate">
            <int>0</int>
        </param>
        <param name="fadeDurationDeactivate">
            <int>0</int>
        </param>
        <param name="fadeDurationShow">
            <int>200</int>
        </param>
        <param name="fadeDurationHide">
            <int>200</int>
        </param>
        <theme name="title" ref="-defaults">
            <param name="border">
                <border>0,5,2,0</border>
            </param>
            <param name="textAlignment">
                <enum type="alignment">left</enum>
            </param>
            <param name="font">
                <font>title-font</font>
            </param>
        </theme>
        <param name="hasCloseButton">
            <bool>false</bool>
        </param>
        <param name="background">
            <image>ui-inner-frame-tab.background</image>
        </param>
    </theme>
    <theme name="base-frame" ref="resizableframe" allowWildcard="true">
        <param name="background">
            <image>ui-inner-frame-tab.background</image>
        </param>
        <param name="titleAreaTop">
            <int>0</int>
        </param>
        <param name="titleAreaLeft">
            <int>10</int>
        </param>
        <param name="titleAreaRight">
            <int>-1</int>
        </param>
        <param name="titleAreaBottom">
            <int>40</int>
        </param>
        <param name="closeButtonX">
            <int>-24</int>
        </param>
        <param name="closeButtonY">
            <int>10</int>
        </param>
        <param name="fadeColorInactive">
            <color>#FFFFFFFF</color>
        </param>
        <param name="fadeDurationActivate">
            <int>200</int>
        </param>
        <param name="fadeDurationDeactivate">
            <int>200</int>
        </param>
        <param name="border">
            <border>0,0,0,0</border>
        </param>
        <theme name="dialoglayout" ref="-defaults">
            <param name="border">
                <border>40,0,0,0</border>
            </param>
            <param name="defaultGap">
                <dimension>5,5</dimension>
            </param>
            <param name="smallGap">
                <dimension>8,8</dimension>
            </param>
            <param name="mediumGap">
                <dimension>10,10</dimension>
            </param>
            <param name="largeGap">
                <dimension>15,15</dimension>
            </param>
            <param name="namedGaps">
                <map/>
            </param>
        </theme>
        <param name="fadeDurationShow">
            <int>0</int>
        </param>
        <param name="fadeDurationHide">
            <int>0</int>
        </param>
    </theme>
    <theme name="tooltipwindow" ref="-defaults">
        <param name="fadeInTime">
            <int>0</int>
        </param>
    </theme>
    <!-- 参考 init.xml 的 menumanager / menupopup，用于输入框右键编辑菜单。 -->
    <theme name="menupopup" ref="dialoglayout">
        <param name="background">
            <image>ui-popup.background</image>
        </param>
        <param name="border">
            <border>5</border>
        </param>
        <param name="namedGaps">
            <map>
                <param name="menuitem">
                    <gap>0</gap>
                </param>
            </map>
        </param>
        <theme name="button" ref="button">
            <param name="background">
                <image>ui-popup-button.background</image>
            </param>
            <param name="font">
                <font>listbox-display</font>
            </param>
            <param name="border">
                <border>5</border>
            </param>
            <param name="minWidth">
                <int>80</int>
            </param>
        </theme>
        <theme name="spacer" ref="-defaults">
            <param name="background">
                <image>ui-spacer.default</image>
            </param>
        </theme>
    </theme>
    <theme name="menumanager" ref="-defaults">
        <param name="border">
            <border>5</border>
        </param>
        <theme name="menupopup" ref="menupopup"/>
    </theme>
    <theme name="logingui" ref="-defaults">
        <theme name="notification" ref="label">
            <param name="background">
                <image>ui-popup.background</image>
            </param>
            <param name="border">
                <!-- 参考外框、DialogLayout、Label 各 5 像素的内边距。 -->
                <border>15</border>
            </param>
            <param name="font">
                <font>pb-dark</font>
            </param>
            <param name="textAlignment">
                <enum type="alignment">CENTER</enum>
            </param>
        </theme>
        <theme name="logo" ref="-defaults">
            <param name="background">
                <image>background-image</image>
            </param>
        </theme>
        <theme name="login-window" ref="base-frame" allowWildcard="true">
            <param name="minWidth">
                <int>300</int>
            </param>
            <param name="minHeight">
                <int>150</int>
            </param>
            <theme name="dialoglayout" ref="dialoglayout">
                <param name="defaultGap">
                    <dimension>8,8</dimension>
                </param>
                <param name="border">
                    <border>60,20,20,20</border>
                </param>
                <theme name="label" ref="label"/>
                <theme name="button" ref="button">
                    <!-- 对齐参考界面的紧凑按钮，余量留给中间的弹性间隔。 -->
                    <param name="minWidth">
                        <int>43</int>
                    </param>
                </theme>
                <theme name="togglebutton" ref="togglebutton"/>
                <theme name="editfield" ref="editfield">
                    <!-- 保持参考登录表单的输入框尺寸，避免字体度量影响布局。 -->
                    <param name="minWidth">
                        <int>210</int>
                    </param>
                    <param name="minHeight">
                        <int>30</int>
                    </param>
                </theme>
            </theme>
        </theme>
        <theme name="label" ref="label">
            <param name="font">
                <font>alphabeta-border</font>
            </param>
        </theme>
    </theme>
</themes>
